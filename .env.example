# =============================================================
# bitcoio · DeFi Trading Dashboard — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================

# --- Bitflow SDK Endpoints (REQUIRED) ---
# Production API Gateway (swap execution, quotes, routes)
BITFLOW_API_HOST=https://bitflow-sdk-api-gateway-7owjsmt8.uc.gateway.dev

# Read-only API node (price feeds, pool data, chain state)
BITFLOW_READONLY_API_HOST=https://node.bitflowapis.finance

# --- Telegram Alerts (OPTIONAL) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (numeric, get via @userinfobot)
TELEGRAM_CHAT_ID=

# =============================================================
# NOTES
# =============================================================
# - BITFLOW_API_HOST: used by the swap aggregator CLI (Bun)
#   to execute trades on-chain. Must point to the production
#   gateway, not the test one.
#
# - BITFLOW_READONLY_API_HOST: used by the Next.js API routes
#   (/api/prices, /api/quote, /api/balance) to fetch live data
#   without spending gas.
#
# - TELEGRAM_*: optional. If left empty, the /api/monitor route
#   will still work for local profit checks, but won't send
#   Telegram messages. To enable alerts, add both values.
#
# - Wallet keystore is NOT in .env — it's managed externally
#   via the /api/wallet unlock/lock flow and stored at
#   ~/.aibtc/wallets/
# =============================================================
